# Server Configuration
PORT=3000
NODE_ENV=development

# MongoDB Connection
MONGO_URI=mongodb://127.0.0.1:27017/job-board

# JWT Secret
JWT_SECRET=your_jwt_secret_key_for_testing

# ===================================================
# Paymob Sandbox / Testing Configuration
# ===================================================
# Paymob Base URL (Default acceptance sandbox/live URL)
PAYMOB_BASE_URL=https://accept.paymob.com

# Paymob Mode: "test" or "sandbox" (ensures sandbox test cards without live charge errors)
PAYMOB_ENVIRONMENT=sandbox
PAYMOB_MODE=test

# Paymob Test API & Secret Keys (from Paymob Dashboard -> Settings / Developers)
PAYMOB_API_KEY=test_api_key_placeholder
PAYMOB_SECRET_KEY=egy_sk_test_placeholder_sec_key
PAYMOB_PUBLIC_KEY=egy_pk_test_placeholder_pub_key

# Paymob Test Integration ID & Iframe ID (from Paymob Dashboard -> Payment Integrations)
PAYMOB_INTEGRATION_ID=456789
PAYMOB_IFRAME_ID=789123

# Paymob Webhook HMAC Secret (from Paymob Dashboard -> Settings)
PAYMOB_HMAC_SECRET=test_hmac_secret_sha512

# Currency
PAYMOB_CURRENCY=EGP
